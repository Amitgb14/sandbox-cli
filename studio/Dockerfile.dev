# The Studio UI, for `docker compose up`.
#
# Deliberately a *dev* image: it runs `next dev` against the source mounted from
# the host, so editing a file changes what you see. A production image would
# build the static export and serve it, which is the wrong shape for the thing
# this compose file exists to do — let someone try Studio without installing a
# Node toolchain.
FROM node:22-bookworm-slim

WORKDIR /app

# Dependencies are installed into the image so the first `up` is the only slow
# one. node_modules is masked by an anonymous volume in compose, which keeps the
# host's copy (built for a different platform, possibly) out of the container.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

EXPOSE 3100
CMD ["npm", "run", "dev"]
