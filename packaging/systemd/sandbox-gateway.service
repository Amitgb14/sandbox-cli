# sandbox-gateway in front of sandboxd nodes (docs/fleet.md).
#
# Unlike sandboxd it needs no root: it holds no devices and starts no VMs. It
# runs as a user of its own (useradd --system sandbox-gateway), with no
# capabilities, a read-only system and only its state directory writable.
#
# Files it reads, all owned by sandbox-gateway and mode 0600 (it refuses a
# token, a client key or its state file other users can read):
#   /etc/sandbox-gateway/nodes.yaml          packaging/fleet/nodes.yaml
#   /etc/sandbox-gateway/*.token             each node's bearer token
#   /etc/sandbox-gateway/tls/                packaging/fleet/make-certs.sh
#   /var/lib/sandbox-gateway/state.json      keys, owners; made on first use
#
# Make the first admin key before starting it, as its user:
#   sudo -u sandbox-gateway sandbox-gateway --state /var/lib/sandbox-gateway/state.json \
#     keys create --user ops --scope admin
[Unit]
Description=sandbox-gateway — one sandbox API in front of many sandboxd nodes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sandbox-gateway
Group=sandbox-gateway
ExecStart=/usr/local/bin/sandbox-gateway serve \
  --state /var/lib/sandbox-gateway/state.json \
  --listen 0.0.0.0:8443 \
  --tls-cert /etc/sandbox-gateway/tls/gateway.pem \
  --tls-key /etc/sandbox-gateway/tls/gateway-key.pem \
  --node-config /etc/sandbox-gateway/nodes.yaml \
  --ssh-listen 0.0.0.0:2222 \
  --ssh-public-host gateway.example.internal
Restart=on-failure
RestartSec=2s
LimitNOFILE=65536

# /var/lib/sandbox-gateway, owned by the service user: the state file, its
# lock, the SSH host key and nodes/ (the only place nodes added through the
# admin API may name files from). Everything else is read-only.
StateDirectory=sandbox-gateway
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

NoNewPrivileges=yes
# No capabilities at all. To bind a port below 1024 (SSH on 22, the API on
# 443), uncomment both lines below instead of running it as root:
CapabilityBoundingSet=
AmbientCapabilities=
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE

# AF_UNIX stays: a node on this machine may be a unix:// endpoint.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
