{
  "boot-source": {
    "kernel_image_path": "/k/vmlinux",
    "boot_args": "console=ttyS0 ro"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/i/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": true
    },
    {
      "drive_id": "scratch",
      "path_on_host": "/s/scratch.ext4",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048
  },
  "vsock": {
    "guest_cid": 3,
    "uds_path": "/s/v.sock"
  }
}
